[sub_resource type="Resource" id="Step_8"]
script = ExtResource("2_step")
act = 2
kind = 3
radius = 4.0
dialogue = ExtResource("6_yes")
only_if = &"help_family"

[sub_resource type="Resource" id="Step_9"]
script = ExtResource("2_step")
act = 2
kind = 3
radius = 4.0
dialogue = ExtResource("7_no")
unless = &"help_family"

[sub_resource type="Resource" id="Step_10"]
script = ExtResource("2_step")
objective = &"OBJ_HOUSES"
act = 3
kind = 1
radius = 4.0
zone = 2
checkpoint = &"Checkpoint3"

[sub_resource type="Resource" id="Step_11"]
