notice = &"NOTICE_SUPPORT"

[sub_resource type="Resource" id="Step_12"]
script = ExtResource("2_step")
objective = &"OBJ_PASS"
act = 3
kind = 1
radius = 4.0
zone = 3
checkpoint = &"Checkpoint4"

[sub_resource type="Resource" id="Step_13"]
script = ExtResource("2_step")
objective = &"OBJ_SUMMIT"
act = 4
kind = 0
marker = &"Ending"
radius = 5.0

[resource]
script = ExtResource("1_seq")
steps = Array[ExtResource("2_step")]([SubResource("Step_0"), SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4"), SubResource("Step_5"), SubResource("Step_6"), SubResource("Step_7"), SubResource("Step_8"), SubResource("Step_9"), SubResource("Step_10"), SubResource("Step_11"), SubResource("Step_12"), SubResource("Step_13")])
