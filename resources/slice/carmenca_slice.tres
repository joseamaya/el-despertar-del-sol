[gd_resource type="Resource" script_class="SliceSequence" format=3]

[ext_resource type="Script" path="res://scripts/systems/slice_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://scripts/systems/slice_step.gd" id="2_step"]
[ext_resource type="Resource" path="res://resources/dialogue/carmenca_opening.tres" id="3_opening"]
[ext_resource type="Resource" path="res://resources/dialogue/carmenca_huaca.tres" id="4_huaca"]
[ext_resource type="Resource" path="res://resources/dialogue/carmenca_family.tres" id="5_family"]
[ext_resource type="Resource" path="res://resources/dialogue/carmenca_family_yes.tres" id="6_yes"]
[ext_resource type="Resource" path="res://resources/dialogue/carmenca_family_no.tres" id="7_no"]
[ext_resource type="Resource" path="res://resources/dialogue/carmenca_family_choice.tres" id="8_choice"]

[sub_resource type="Resource" id="Step_0"]
script = ExtResource("2_step")
act = 0
kind = 3
radius = 4.0
dialogue = ExtResource("3_opening")
checkpoint = &"Start"

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
objective = &"OBJ_TERRACES"
act = 1
kind = 1
radius = 4.0
zone = 1
checkpoint = &"Checkpoint1"

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("2_step")
objective = &"OBJ_HUACA"
optional = true
act = 1
kind = 4
marker = &"Huaca"
radius = 4.0
prompt = &"PROMPT_OFFERING"
checkpoint = &"Checkpoint2"

[sub_resource type="Resource" id="Step_3"]
script = ExtResource("2_step")
optional = true
act = 1
kind = 5
marker = &"Huaca"
radius = 4.0
notice = &"NOTICE_OFFERING"

[sub_resource type="Resource" id="Step_4"]
script = ExtResource("2_step")
optional = true
act = 1
kind = 3
radius = 4.0
dialogue = ExtResource("4_huaca")

[sub_resource type="Resource" id="Step_5"]
script = ExtResource("2_step")
objective = &"OBJ_TO_HOUSES"
act = 2
kind = 0
marker = &"Family"
radius = 6.0

[sub_resource type="Resource" id="Step_6"]
script = ExtResource("2_step")
act = 2
kind = 3
radius = 4.0
dialogue = ExtResource("5_family")

[sub_resource type="Resource" id="Step_7"]
script = ExtResource("2_step")
act = 2
kind = 6
radius = 4.0
