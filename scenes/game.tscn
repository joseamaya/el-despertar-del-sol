[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/systems/game_shell.gd" id="1_shell"]
[ext_resource type="Script" path="res://scripts/systems/level_host.gd" id="2_host"]
[ext_resource type="Resource" path="res://resources/levels/level_catalog.tres" id="3_catalog"]
[ext_resource type="Script" path="res://scripts/ui/title_menu.gd" id="4_title"]
[ext_resource type="Script" path="res://scripts/ui/loading_screen.gd" id="5_loading"]

[node name="Game" type="Node" node_paths=PackedStringArray("host", "title")]
script = ExtResource("1_shell")
host = NodePath("LevelHost")
title = NodePath("TitleMenu")

[node name="LevelHost" type="Node" parent="." node_paths=PackedStringArray("loading")]
script = ExtResource("2_host")
catalog = ExtResource("3_catalog")
loading = NodePath("../LoadingScreen")

[node name="TitleMenu" type="CanvasLayer" parent="."]
script = ExtResource("4_title")

[node name="LoadingScreen" type="CanvasLayer" parent="."]
script = ExtResource("5_loading")
