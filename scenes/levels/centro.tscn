[node name="Centro" instance=ExtResource("1_carmenca")]

[node name="SectorLevel" parent="."]
layout = ExtResource("2_layout")

[node name="SliceDirector" parent="."]
autostart = false

[node name="Crowd" parent="."]
people = ExtResource("4_people")

[node name="HubTalks" type="Node" parent="." node_paths=PackedStringArray("level", "player", "prompt", "dialogue", "choice", "people")]
script = ExtResource("3_talks")
level = NodePath("../SectorLevel")
player = NodePath("../Player")
prompt = NodePath("../InteractionPrompt")
dialogue = NodePath("../DialoguePlayer")
choice = NodePath("../ChoiceBox")
talks = Array[ExtResource("19_talk")]([ExtResource("11_talk_apo_mayta"), ExtResource("12_talk_llamas"), ExtResource("13_talk_prisioneros"), ExtResource("14_talk_disputa"), ExtResource("15_talk_combate_visible"), ExtResource("16_talk_susurpuquio")])
question = ExtResource("17_question")
arrival = ExtResource("18_arrival")
people = [NodePath("../ApoMayta"), NodePath("../CuracaValle"), NodePath("../CuracaQuilescachis"), NodePath("../CuracaCamino"), NodePath("../Vicaquirao")]

[node name="LevelEntry" parent="." node_paths=PackedStringArray("hub_talks")]
